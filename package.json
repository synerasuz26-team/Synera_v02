{
  "name": "synera-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run src/features/auth packages/api",
    "test:e2e": "node scripts/e2e.mjs",
    "test:p4": "node scripts/p4-e2e.mjs",
    "test:p5": "node scripts/p5-e2e.mjs",
    "test:p6": "node scripts/p6-e2e.mjs",
    "test:p7": "powershell -NoProfile -ExecutionPolicy Bypass -File backend/scripts/test-p7.ps1",
    "test:p8": "node scripts/verify-deploy-env.mjs",
    "db:backup": "node scripts/backup.mjs",
    "db:restore": "node scripts/restore.mjs",
    "db:verify": "node scripts/verify-db.mjs",
    "check:deploy-env": "node scripts/verify-deploy-env.mjs",
    "test:design": "node scripts/design-check.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:p4": "node scripts/check-p4.mjs",
    "format": "prettier --write src scripts index.html package.json",
    "format:check": "prettier --check src scripts index.html package.json"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "gsap": "^3.12.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.4.0",
    "typescript": "~5.6.3",
    "vite": "^6.0.1",
    "vitest": "^2.1.8"
  }
}
