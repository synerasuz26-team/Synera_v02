# Enter in Railway Variables. Do not commit actual secrets or public database URLs.
APP_ENV=production
DB_ENVIRONMENT=production
DB_URL=jdbc:postgresql://${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}
DB_USER=${{Postgres.PGUSER}}
DB_PASSWORD=${{Postgres.PGPASSWORD}}
DB_POOL_SIZE=3
JWT_SECRET=<generate-at-least-32-random-bytes-unique-to-production>
CORS_ORIGINS=https://<frontend-domain>
SEED_DEMO=false
APP_JOBS_ENABLED=true
FEATURE_PHOTOS=false
# Configure these only after provisioning an external private object store:
# FEATURE_PHOTOS=true
# S3_REGION=auto
# S3_ENDPOINT=https://<object-storage-endpoint>
# S3_BUCKET=<private-production-bucket>
# S3_ACCESS_KEY_ID=<restricted-production-key>
# S3_SECRET_ACCESS_KEY=<restricted-production-secret>
# S3_PATH_STYLE=true
HTTP_LOGIN_PER_MINUTE=10
HTTP_WRITES_PER_MINUTE=120
DB_WARNING_BYTES=350000000
DB_CRITICAL_BYTES=425000000
# Frontend service: VITE_* are BUILD variables. API_ORIGIN/STORAGE_ORIGIN are runtime CSP variables.
VITE_API_URL=https://<api-domain>
VITE_USE_MOCK=false
API_ORIGIN=https://<api-domain>
STORAGE_ORIGIN=https://<public-browser-accessible-s3-endpoint>
