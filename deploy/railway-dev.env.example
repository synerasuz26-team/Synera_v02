# Set these in the new Railway dev project; never commit the resolved values.
APP_ENV=dev
DB_ENVIRONMENT=dev
DB_URL=jdbc:postgresql://${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}
DB_USER=${{Postgres.PGUSER}}
DB_PASSWORD=${{Postgres.PGPASSWORD}}
DB_POOL_SIZE=3
JWT_SECRET=<generate-at-least-32-random-bytes-for-dev>
CORS_ORIGINS=https://<frontend-domain>
SEED_DEMO=true
SEED_DEMO_PASSWORD=<set-a-private-demo-password-in-Railway>
APP_JOBS_ENABLED=true
FEATURE_PHOTOS=false
# Frontend service build/runtime variables:
VITE_API_URL=https://<api-domain>
VITE_USE_MOCK=false
API_ORIGIN=https://<api-domain>
STORAGE_ORIGIN=https://<api-domain>
